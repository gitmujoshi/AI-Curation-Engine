# Application Settings
APP_NAME=Perimeter Gateway
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=*
API_KEY_HEADER=X-Perimeter-API-Key

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
CACHE_TTL_SECONDS=3600

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://perimeter:perimeter@localhost:5432/perimeter
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# BAML Configuration
BAML_SCHEMA_PATH=config/baml_src
BAML_VALIDATE_INPUTS=true
BAML_VALIDATE_OUTPUTS=true

# Headroom Compression
COMPRESSION_ENABLED=true
MIN_COMPRESSION_SIZE=1024
TARGET_COMPRESSION_RATIO=0.15

# Content Router
CODE_COMPRESSION_ENABLED=true
JSON_COMPRESSION_ENABLED=true
PROSE_COMPRESSION_ENABLED=true

# PII Detection
PII_DETECTION_ENABLED=true
PII_ANONYMIZE=true
PII_DETECTION_THRESHOLD=0.85

# Guardrails
PROMPT_INJECTION_DETECTION=true
JAILBREAK_DETECTION=true
MAX_PROMPT_LENGTH=100000

# LLM Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Billing
STRIPE_API_KEY=your-stripe-api-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
BILLING_SYNC_INTERVAL_SECONDS=3600
PRICE_PER_1K_TOKENS=0.001

# Performance
MAX_PROXY_LATENCY_MS=5
CACHE_HYDRATION_TIMEOUT_MS=3
REQUEST_TIMEOUT_SECONDS=300

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_MEMORYSTORE_HOST=
GCP_STORAGE_BUCKET=

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=true
METRICS_PORT=9090
